{
  "name": "life-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tz": "for z in UTC Asia/Tokyo Australia/Lord_Howe Pacific/Kiritimati America/Los_Angeles; do echo \"== $z\"; TZ=$z vitest run; done",
    "setup": "node scripts/setup.mjs",
    "test:notify": "node scripts/notify.mjs",
    "check:deno": "npx --yes deno@2 check supabase/functions/dispatch/index.ts supabase/functions/parse-food/index.ts supabase/functions/assist/index.ts supabase/functions/calendar/index.ts supabase/functions/feeds/index.ts",
    "check": "npm run build && npm test && npm run check:deno",
    "set:url": "node scripts/set-app-url.mjs",
    "doses": "node scripts/doses.mjs",
    "secret": "node scripts/secret.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "animejs": "^4.5.0",
    "idb": "^8.0.3",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zxing-wasm": "^3.1.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/animejs": "^3.1.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
