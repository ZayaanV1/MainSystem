# =============================================================================
# Copy this file to .env.setup and fill in the seven values below.
# Then run:  npm run setup
#
# .env.setup is gitignored. Nothing in it is ever committed.
# You do not need to generate VAPID keys or a cron secret — setup makes those.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Dashboard > your project. The ref is the subdomain in the project URL:
#   https://supabase.com/dashboard/project/abcdefghijklmnop
#                                          ^^^^^^^^^^^^^^^^
SUPABASE_PROJECT_REF=

# The database password you chose when creating the project.
# Dashboard > Project Settings > Database > Reset password, if you lost it.
SUPABASE_DB_PASSWORD=

# Dashboard > Project Settings > API keys.
# The anon key is public and ships in the browser bundle. That is expected and
# safe: RLS is what protects the data, not the key.
SUPABASE_ANON_KEY=

# The service role key bypasses RLS entirely. It is used only by setup and by
# the edge function. It must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# A personal access token, so setup can run without an interactive login.
# Create one at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=


# --- Telegram ----------------------------------------------------------------
# Message @BotFather, send /newbot, follow the prompts. It replies with a token
# that looks like 1234567890:AAExample-TokenStringGoesHere
#
# IMPORTANT: after creating the bot, open a chat with it and send it any
# message. Setup finds your chat ID from that message; without it there is
# nothing to find and setup will tell you so.
TELEGRAM_BOT_TOKEN=


# --- Your account ------------------------------------------------------------
# The single account for this app. Setup creates it, already confirmed, so
# there is no verification email to wait for.
# Use a real password and put it in your password manager now.
APP_EMAIL=
APP_PASSWORD=
